#lang pollen

/* Setting the font. */
:root {
  font-family: "Charis SIL", serif;
  font-size: 1.1em;
}

/* Centering the page */
body {
  margin: 3rem auto;
  max-width: 570px;
}

@media screen and (max-width: 570px) {
  body {
    max-width: 95%;
    font-size: 0.85em;
  }
}

h2 {
  font-size: 1.75em;
}

a:hover {
  background-color: #f0f0f0;
}

blockquote {
  background: #f4f4eb;
  max-width: 450px;
}

footer {
  font-size: 0.7em;
}
